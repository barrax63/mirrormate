# Required: OpenAI, for replies, what's said after the wake word, memory and the camera.
# It never hears the room before the wake word: local Whisper, which compose.yaml runs, does.
#
# Recommended: set a hard spend limit on the OpenAI project this key belongs to, so a bug or
# a busy room can't run up a bill. In platform.openai.com, open the project's settings, select
# Limits, then under Spend select Edit spend limit, enter a monthly limit, turn on "Enforce a
# hard limit" and save. Requests past it fail, and both pages say so.
OPENAI_API_KEY=your_openai_api_key_here

# Required: ElevenLabs, for speech output.
# The key needs the Text to Speech permission, and Voices read access for the voice selector
# on /control.
#
# Recommended: ElevenLabs uses some of what you send it to improve its models, unless you opt
# out. Click your profile icon in ElevenLabs, go to Terms and privacy > Data use, turn off
# "Improve the models for everyone" and click "Update your choice". It applies from then on.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Google Calendar (Service Account)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_ID=your-email@gmail.com

# Optional: Web Search (Ollama)
# Get Ollama API key from: https://ollama.com/settings/keys
# OLLAMA_API_KEY=your_ollama_api_key_here

# Optional: Discord Webhook (for sharing search results to phone)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Optional: address to publish port 3000 on. The app has no authentication, so
# anything that can reach the port has full access. The default is this machine
# only. To allow other devices, use an address on a private network, such as this
# machine's Tailscale IP.
# BIND_ADDRESS=127.0.0.1
